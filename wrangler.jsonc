{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sloptracker",
	"account_id": "079e9a611902a974606aac8db6dfe3a3",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-01",
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": ["/", "/api/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sloptracker",
			"database_id": "26d45121-7856-4b11-8aed-00ac3a18dc49"
		}
	],
	"triggers": { "crons": ["*/10 * * * *"] },
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	"routes": [{ "pattern": "slop.stackrot.dev", "custom_domain": true }],
	"observability": { "enabled": true }
}
