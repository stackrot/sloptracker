{
	"name": "sloptracker",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"types": "wrangler types",
		"typecheck": "bun run types && tsc --noEmit",
		"check": "bun run typecheck && bun test",
		"migrate": "wrangler d1 migrations apply DB --remote",
		"deploy": "bun run check && wrangler deploy"
	},
	"devDependencies": {
		"@types/bun": "^1.4.5",
		"typescript": "7.0.2",
		"wrangler": "4.166.0"
	}
}
